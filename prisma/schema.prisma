generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum StationStatus {
  AVAILABLE
  MAINTENANCE
  INACTIVE
}

enum ChargerType {
  NORMAL
  FAST
  ULTRA
}

enum SlotStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  E_WALLET
}

enum BookingAdjustmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum AdjustmentPaymentStatus {
  PENDING
  PAID
  FAILED
}

enum BookingAdjustmentType {
  ADDITIONAL_PAYMENT
  REFUND
}

model User {
  id           Int       @id @default(autoincrement())
  fullName     String    @map("full_name")
  email        String    @unique
  passwordHash String    @map("password_hash")
  phoneNumber  String?   @map("phone_number")
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  bookings     Booking[]

  @@map("users")
}

model ChargingStation {
  id          Int            @id @default(autoincrement())
  name        String
  location    String
  area        String
  address     String
  latitude    Decimal        @db.Decimal(10, 7)
  longitude   Decimal        @db.Decimal(10, 7)
  status      StationStatus  @default(AVAILABLE)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  slots       ChargingSlot[]

  @@map("charging_stations")
}

model ChargingSlot {
  id          Int             @id @default(autoincrement())
  stationId   Int             @map("station_id")
  slotCode    String          @map("slot_code")
  chargerType ChargerType     @map("charger_type")
  powerKw     Int             @map("power_kw")
  pricePerKwh Decimal         @map("price_per_kwh") @db.Decimal(10, 2)
  status      SlotStatus      @default(AVAILABLE)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  bookings    Booking[]
  station     ChargingStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, slotCode])
  @@map("charging_slots")
}

model Booking {
  id            Int           @id @default(autoincrement())
  userId        Int           @map("user_id")
  slotId        Int           @map("slot_id")
  bookingCode   String        @unique @map("booking_code")
  startTime     DateTime      @map("start_time")
  endTime       DateTime      @map("end_time")
  estimatedKwh  Decimal?      @map("estimated_kwh") @db.Decimal(10, 2)
  estimatedCost Decimal?      @map("estimated_cost") @db.Decimal(12, 2)
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  slot          ChargingSlot  @relation(fields: [slotId], references: [id])
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment       Payment?
  adjustments   BookingAdjustment[]

  @@map("bookings")
}

model Payment {
  id            Int           @id @default(autoincrement())
  bookingId     Int           @unique @map("booking_id")
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @map("payment_method")
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique @map("transaction_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model BookingAdjustment {
  id               Int                     @id @default(autoincrement())
  bookingId        Int                     @map("booking_id")
  slotId           Int                     @map("slot_id")
  startTime        DateTime                @map("start_time")
  endTime          DateTime                @map("end_time")
  estimatedKwh     Decimal                 @map("estimated_kwh") @db.Decimal(10, 2)
  estimatedCost    Decimal                 @map("estimated_cost") @db.Decimal(12, 2)
  adjustmentAmount Decimal                 @map("adjustment_amount") @db.Decimal(12, 2)
  type             BookingAdjustmentType   @default(ADDITIONAL_PAYMENT)
  status           BookingAdjustmentStatus @default(PENDING)
  paymentStatus    AdjustmentPaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod    PaymentMethod?          @map("payment_method")
  transactionId    String?                 @unique @map("transaction_id")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  booking          Booking                 @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_adjustments")
}
